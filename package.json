{
  "name": "tagada",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @tagada/web dev",
    "dev:server": "pnpm --filter @tagada/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "smoke": "playwright test",
    "appwrite:setup": "tsx --env-file-if-exists=.env scripts/appwrite-setup.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@tagada/appwrite": "workspace:*",
    "node-appwrite": "31.0.0"
  }
}
