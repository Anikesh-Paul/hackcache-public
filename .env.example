# Every environment variable Tagada reads. Copy to .env for local work; on
# Render they live in the `tagada-env` environment group. Never commit values
# for anything named *_KEY, *_SECRET or *_TOKEN.

# Appwrite (Singapore). The browser only ever gets the endpoint and project ID.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT=tagada
# Server key, scopes: rows.read rows.write tables.read files.read files.write users.read
APPWRITE_KEY=
# Schema key for `pnpm appwrite:setup` only (databases/tables/columns/indexes/buckets
# read+write). Short-lived; not needed on Render.
APPWRITE_SETUP_KEY=

# Web app (Vite inlines VITE_* at build time; never put a secret here)
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=tagada
VITE_SERVER_URL=http://localhost:8787

# Server
WEB_ORIGIN=http://localhost:5173
PAY_TOKEN_SECRET=

# ElevenLabs voice agent
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Gemini (payment proof reading)
GEMINI_API_KEY=

# Resend (reminder emails, shared address, delivered to the Demo inbox)
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=resend.dev
# The Demo inbox: the Resend account's own email, the only address the shared sender delivers to
DEMO_INBOX_EMAIL=

# Render API, used by the server and cron to start workflow runs
RENDER_API_KEY=
